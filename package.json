{
  "name": "@lyeve-labs/ui-kit-react",
  "version": "0.1.0",
  "description": "React ports of the LyEve ui-kit components a page for visitors draws with, rendered on the server with the same markup as the Svelte originals.",
  "license": "MIT",
  "author": "LyEve Labs <hello@lyeve.com>",
  "homepage": "https://github.com/lyeve-labs/ui-kit-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyeve-labs/ui-kit-react.git"
  },
  "bugs": {
    "url": "https://github.com/lyeve-labs/ui-kit-react/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui-kit",
    "server-components",
    "design-system",
    "lyeve"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-site-css.mjs && publint",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./site.css": "./dist/site.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@lucide/svelte": "0.511.0",
    "@lyeve-labs/ui-kit": "0.60.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
